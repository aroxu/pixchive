# Keep the default local image when building yourself. For GHCR, set:
# PIXCHIVE_IMAGE=ghcr.io/aroxu/pixchive:latest
PIXCHIVE_BIND_HOST=0.0.0.0
PIXCHIVE_PORT=8000
PIXCHIVE_PUBLIC_URL=http://localhost:8000
# Exact additional browser origins, separated by commas; no paths.
PIXCHIVE_ALLOWED_ORIGINS=
# Optional login browser: add -f compose.browser.yml when running Docker Compose.
# Browser navigation/connection validation interval, in seconds (60..86400).
PIXCHIVE_BROWSER_REFRESH_SECONDS=600
