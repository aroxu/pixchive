# Public deployment metadata only. Shell-compatible; no cookies, keys or auth values.
# Parent prepares these exact tags from the current images; they are not published here.
PIXCHIVE_IMAGE=pixchive:archiver-media-jitter-20261120
PIXCHIVE_BROWSER_IMAGE=pixchive-browser:archiver-nasfix-20261027
PIXCHIVE_ROOT=/mnt/storage/pixchive
# Host-local XFS/ext4 scratch bind; DB and finalized archive remain on NAS.
PIXCHIVE_CACHE_ROOT=/cache/pixchive
# Explicit unsupported SQLite/WAL-on-NFS experiment, never a stable deployment claim.
PIXCHIVE_NFS_TRIAL=1
PIXCHIVE_PUBLIC_URL=http://archiver:28000
# Comma-separated additional exact HTTP/HTTPS origins, without paths or trailing slash.
PIXCHIVE_ALLOWED_ORIGINS=
PIXCHIVE_BROWSER_REFRESH_SECONDS=600
# Optional: pin the parent's prepared Redis image by digest too.
PIXCHIVE_REDIS_IMAGE=redis:8-alpine
